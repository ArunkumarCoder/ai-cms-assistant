# Copy to .env.local and fill in your own values. Never commit .env.local.
#
# Every variable below (except the WordPress staging block, which is dev/test-
# only) is validated at server startup by src/lib/env.ts/instrumentation.ts —
# a missing or malformed one fails fast with a specific, readable error
# naming exactly which variable is wrong, instead of surfacing later as an
# opaque error from whichever library first touches it.
#
# PRODUCTION gets its own copy of every one of these, generated fresh — never
# reused from dev. In particular: NEXT_PUBLIC_SANITY_DATASET below defaults to
# "development" specifically so a careless production setup doesn't collide
# with dev's own content by both pointing at a dataset literally named
# "production" — give the real production deployment a dataset actually named
# "production" (or similar), separate from whatever dev uses. See SPEC.md's
# Day 37 section for the full environment layout.

# Sanity
# Project ID is not secret; the real value is committed here so the app and
# Studio agree on which project to point at. Dataset name follows the same
# rule — not secret, but still worth getting right per the note above.
NEXT_PUBLIC_SANITY_PROJECT_ID=nrk18555
NEXT_PUBLIC_SANITY_DATASET=development
SANITY_API_TOKEN=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# App datastore (accounts + connected Sites — Sanity projects or WordPress
# installs, see SPEC.md §8). Postgres, not SQLite — a file-based DB doesn't
# survive Vercel's serverless filesystem. Provisioned here via the "Prisma
# Postgres" Vercel marketplace integration; any Postgres connection string
# works.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# NextAuth (Auth.js v5) session signing key. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# AES-256-GCM key used to encrypt connected Sites' third-party credentials at
# rest — a Sanity API token or a WordPress Application Password, same key and
# cipher either way (src/lib/crypto/siteToken.ts) — must decode to exactly 32
# bytes. Generate with:
#   openssl rand -base64 32
SITE_TOKEN_ENCRYPTION_KEY=

# WordPress staging site, used only by this adapter's own test/dev scripts —
# not read by the app's own runtime, which takes a WordPress site's URL/
# username/application password through the real "connect a site" UI instead
# (see README's "Connecting WordPress" section). WORDPRESS_STAGING_URL points
# at a local WP install with Application Passwords enabled (wp-config.php
# needs `WP_ENVIRONMENT_TYPE` set to `local` for this to work over plain HTTP
# — see SPEC.md §22 for why). Generate the application password with:
#   wp user application-password create <user> "ai-cms-assistant-adapter" --porcelain
WORDPRESS_STAGING_URL=
WORDPRESS_STAGING_USERNAME=
WORDPRESS_STAGING_APPLICATION_PASSWORD=

# Cost/abuse protection (Day 37) — all optional, each with a built-in
# default (src/lib/ai/spendCap.ts). Set these to override the defaults for a
# specific deployment; leave unset to use them as-is.
#   AI_MONTHLY_SPEND_CAP_USD      — hard global ceiling, across every user,
#                                   on this deployment's total estimated AI
#                                   spend per calendar month. Default: 20.
#   AI_DAILY_CALL_CAP             — per-user daily AI call limit for a real
#                                   (non-demo) account. Default: 40.
#   AI_DAILY_CALL_CAP_DEMO        — the same, but for the public demo account
#                                   specifically (always tighter than real
#                                   accounts — anyone can reach it). Default: 8.
AI_MONTHLY_SPEND_CAP_USD=
AI_DAILY_CALL_CAP=
AI_DAILY_CALL_CAP_DEMO=
