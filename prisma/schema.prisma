// App-level datastore (Day 6). Sanity remains the CMS for Page/ImageAsset
// content; this database only holds what the app itself owns — accounts and
// which Sanity project each account has connected — per SPEC.md §2's
// "our own DB id" distinction that CmsAdapter's design notes already assumed
// would exist eventually.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  sites        Site[]
}

// Mirrors src/types/site.ts's `Site` interface, plus ownership (`userId`) and
// the encrypted credential the domain type deliberately never carries (see
// src/lib/crypto/siteToken.ts) — CmsAdapter and the rest of the app only ever
// see the plain `Site` shape, never this row directly.
model Site {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  cms                   String   @default("sanity")
  // Sanity-only fields — nullable now that `cms` can be "wordpress" (Day 27).
  // Previously required (non-nullable); a WordPress-backed Site has neither,
  // so the constraint had to move from the column to buildSanityAdapter()/
  // connectSiteAction.ts (checked per-`cms` branch instead).
  sanityProjectId       String?
  sanityDataset         String?
  // Ciphertext only — see src/lib/crypto/siteToken.ts for the encrypt/decrypt
  // pair. Nullable because a connected project could in principle be
  // read-only/public with no token (SanityAdapter already supports that),
  // even though today's connect flow always asks for one.
  sanityTokenCiphertext String?
  // WordPress-only fields (Day 27) — mirrors the Sanity fields above one for
  // one: a plain non-secret identifier (wordpressUrl, like sanityProjectId),
  // a plain username (Application Passwords authenticate as a specific WP
  // user, unlike Sanity's project-scoped token), and an encrypted secret
  // (wordpressAppPasswordCiphertext, same encryptSiteToken/decryptSiteToken
  // pair as sanityTokenCiphertext — the function was already generic, not
  // Sanity-specific, despite its one prior caller).
  wordpressUrl                    String?
  wordpressUsername               String?
  wordpressAppPasswordCiphertext  String?
  // Optional per-site style guide threaded into every AI generation/
  // regeneration prompt for this site (src/lib/pages/prompt.ts) — app-DB
  // only, same treatment as SeoAudit/qualityScore: it's workflow input, not
  // CMS content, so it has no Sanity-side equivalent.
  brandVoice            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

// One row per AI call (src/lib/ai/logging.ts), success or failure — the
// foundation for the Phase 5 cost dashboard (Phase 2 Day 1). `callType` and
// `provider` are plain strings, not enum/relation types: the AI layer's own
// `AiCallType`/`AiProviderName` (src/lib/ai/types.ts) are the source of
// truth for valid values, and a Prisma enum would mean a migration every
// time a new AI feature/provider is added. `siteId`/`userId` are nullable,
// unenforced foreign keys (not `@relation`) rather than Cascade-linked to
// User/Site: a deleted Site/User shouldn't silently delete its historical
// cost data out from under a spend dashboard.
model AiCallLog {
  id               String   @id @default(cuid())
  callType         String
  provider         String
  model            String
  inputTokens      Int
  outputTokens     Int
  estimatedCostUsd Float
  durationMs       Int
  success          Boolean
  errorMessage     String?
  siteId           String?
  userId           String?
  // Set only on a row logged for a *fallback* attempt (src/lib/ai/client.ts,
  // SPEC.md §21) — the name of the provider that was actually configured for
  // this call type and failed first, triggering the fallback. Never set on
  // the primary attempt's own (separate) failure row — that row already
  // records its own `provider`/`success: false`; this field exists so a
  // fallback is always visible in the log as a real, distinguishable event
  // ("log that a fallback occurred, don't silently swap providers"), not
  // just a second row that looks identical to an unrelated ordinary call.
  fallbackFrom     String?
  createdAt        DateTime @default(now())

  @@index([callType])
  @@index([siteId])
  @@index([createdAt])
}

// Append-only history for src/lib/quality/'s composite quality score
// (SPEC.md §10-11). The *current* score is denormalized onto the Sanity page
// document itself (Page.qualityScore) for cheap list-view reads — this table
// exists because that single field can't also hold "every score this page
// has ever had." `pageId` is the Sanity document id (Page.cmsDocumentId),
// not a Prisma relation: Sanity, not Postgres, is the source of truth for
// Page content, same reasoning AiCallLog already uses for its own unenforced
// siteId/userId rather than a `@relation`. `subScores` mirrors
// QualityScore["subScores"] (src/lib/ai/schemas/qualityScore.ts) verbatim —
// each sub-score's `reason` text included, not just its number, since a
// future trend view (Phase 5) will want to show *why* a score moved, not
// just that it did.
model QualityScoreHistory {
  id        String   @id @default(cuid())
  pageId    String
  siteId    String
  score     Int
  subScores Json
  createdAt DateTime @default(now())

  @@index([pageId])
  @@index([siteId])
  @@index([createdAt])
}

// Append-only audit trail per page (SPEC.md §18) — "what changed, by whom,
// when" for every meaningful change this app makes: an AI edit actually
// persisted, a status transition, or a plain content/FAQ save. Deliberately
// a flat timestamped log, not a generic event-sourcing system (task's own
// "keep the shape simple") — same pattern as QualityScoreHistory/AiCallLog,
// `pageId`/`siteId` unenforced strings rather than `@relation`s for the same
// reason those two already use: Sanity, not Postgres, owns Page content.
// `userEmail` is denormalized at write time instead of joined from `userId`
// at read time — the History panel always wants a human-readable "by whom,"
// and there's no reason to pay a join per history read for it.
model PageAuditLogEntry {
  id        String   @id @default(cuid())
  pageId    String
  siteId    String
  userId    String?
  userEmail String?
  action    String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([pageId])
  @@index([siteId])
  @@index([createdAt])
}
