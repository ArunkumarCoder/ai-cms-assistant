# Copy to .env.local and fill in your own values. Never commit .env.local.

# Sanity
# Project ID is not secret; the real value is committed here so the app and
# Studio agree on which project to point at. Dataset name follows the same rule.
NEXT_PUBLIC_SANITY_PROJECT_ID=nrk18555
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# App datastore (accounts + connected Sanity projects — see SPEC.md §8).
# Postgres, not SQLite — a file-based DB doesn't survive Vercel's serverless
# filesystem. Provisioned here via the "Prisma Postgres" Vercel marketplace
# integration; any Postgres connection string works.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# NextAuth (Auth.js v5) session signing key. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# AES-256-GCM key used to encrypt connected Sites' Sanity API tokens at rest —
# must decode to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
SITE_TOKEN_ENCRYPTION_KEY=

# WordPress staging site (Phase 6, SPEC.md §22) — used for developing and
# testing the WordPressAdapter, not by the app's own runtime env-var loading
# yet (WordPress isn't a connectable Site type until that adapter exists).
# WORDPRESS_STAGING_URL points at a local WP install with Application
# Passwords enabled (wp-config.php needs `WP_ENVIRONMENT_TYPE` set to
# `local` for this to work over plain HTTP — see SPEC.md §22 for why).
# Generate the application password with:
#   wp user application-password create <user> "ai-cms-assistant-adapter" --porcelain
WORDPRESS_STAGING_URL=
WORDPRESS_STAGING_USERNAME=
WORDPRESS_STAGING_APPLICATION_PASSWORD=
