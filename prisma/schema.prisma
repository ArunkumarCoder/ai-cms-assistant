// App-level datastore (Day 6). Sanity remains the CMS for Page/ImageAsset
// content; this database only holds what the app itself owns — accounts and
// which Sanity project each account has connected — per SPEC.md §2's
// "our own DB id" distinction that CmsAdapter's design notes already assumed
// would exist eventually.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  sites        Site[]
}

// Mirrors src/types/site.ts's `Site` interface, plus ownership (`userId`) and
// the encrypted credential the domain type deliberately never carries (see
// src/lib/crypto/siteToken.ts) — CmsAdapter and the rest of the app only ever
// see the plain `Site` shape, never this row directly.
model Site {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  cms                   String   @default("sanity")
  sanityProjectId       String
  sanityDataset         String
  // Ciphertext only — see src/lib/crypto/siteToken.ts for the encrypt/decrypt
  // pair. Nullable because a connected project could in principle be
  // read-only/public with no token (SanityAdapter already supports that),
  // even though today's connect flow always asks for one.
  sanityTokenCiphertext String?
  // Optional per-site style guide threaded into every AI generation/
  // regeneration prompt for this site (src/lib/pages/prompt.ts) — app-DB
  // only, same treatment as SeoAudit/qualityScore: it's workflow input, not
  // CMS content, so it has no Sanity-side equivalent.
  brandVoice            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

// One row per AI call (src/lib/ai/logging.ts), success or failure — the
// foundation for the Phase 5 cost dashboard (Phase 2 Day 1). `callType` and
// `provider` are plain strings, not enum/relation types: the AI layer's own
// `AiCallType`/`AiProviderName` (src/lib/ai/types.ts) are the source of
// truth for valid values, and a Prisma enum would mean a migration every
// time a new AI feature/provider is added. `siteId`/`userId` are nullable,
// unenforced foreign keys (not `@relation`) rather than Cascade-linked to
// User/Site: a deleted Site/User shouldn't silently delete its historical
// cost data out from under a spend dashboard.
model AiCallLog {
  id               String   @id @default(cuid())
  callType         String
  provider         String
  model            String
  inputTokens      Int
  outputTokens     Int
  estimatedCostUsd Float
  durationMs       Int
  success          Boolean
  errorMessage     String?
  siteId           String?
  userId           String?
  createdAt        DateTime @default(now())

  @@index([callType])
  @@index([siteId])
  @@index([createdAt])
}
