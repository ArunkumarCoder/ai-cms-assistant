# Copy to .env.local and fill in your own values. Never commit .env.local.

# Sanity
# Project ID is not secret; the real value is committed here so the app and
# Studio agree on which project to point at. Dataset name follows the same rule.
NEXT_PUBLIC_SANITY_PROJECT_ID=nrk18555
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# App datastore (accounts + connected Sanity projects — see SPEC.md §8)
DATABASE_URL="file:./dev.db"

# NextAuth (Auth.js v5) session signing key. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# AES-256-GCM key used to encrypt connected Sites' Sanity API tokens at rest —
# must decode to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
SITE_TOKEN_ENCRYPTION_KEY=
