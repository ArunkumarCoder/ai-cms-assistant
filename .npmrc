# next-sanity/@sanity/client pull in an optional @sanity/cli peer chain whose
# own transitive deps (get-it -> vitest -> @types/node) conflict with this
# project's own vitest/@types/node versions. `npm install` (no lockfile) hits
# this ERESOLVE on any clean install, including Vercel's build — legacy-peer-
# deps is how it was resolved locally too (see package-lock.json history).
legacy-peer-deps=true
